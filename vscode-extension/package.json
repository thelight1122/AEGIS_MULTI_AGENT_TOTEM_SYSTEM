{
  "name": "aegis-totem-vscode",
  "displayName": "AEGIS Totem",
  "description": "Browse repo Totems and agent lanes from VS Code.",
  "version": "0.1.0",
  "publisher": "thelight1122",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thelight1122/AEGIS_MULTI_AGENT_TOTEM_SYSTEM.git",
    "directory": "vscode-extension"
  },
  "engines": { "vscode": "^1.85.0" },
  "main": "./extension.js",
  "files": ["extension.js", "README.md", "LICENSE"],
  "activationEvents": ["onStartupFinished"],
  "categories": ["Other"],
  "contributes": {
    "commands": [
      { "command": "aegisTotem.refresh", "title": "AEGIS: Refresh" },
      { "command": "aegisTotem.openRoot", "title": "AEGIS: Open Root Totem" },
      { "command": "aegisTotem.status", "title": "AEGIS: Show Status" },
      { "command": "aegisTotem.analytics", "title": "AEGIS: Show Analytics" },
      { "command": "aegisTotem.validate", "title": "AEGIS: Validate" },
      { "command": "aegisTotem.sendMessage", "title": "AEGIS: Send Lane Message" },
      { "command": "aegisTotem.appendFolderUpdate", "title": "AEGIS: Append Folder Update" }
    ],
    "views": { "explorer": [{ "id": "aegisTotemView", "name": "AEGIS Totem" }] },
    "menus": { "view/title": [{ "command": "aegisTotem.refresh", "when": "view == aegisTotemView", "group": "navigation" }] }
  }
}
